# Base URL of ladder-backend (no trailing slash). Required for production builds.
# In production use /api/v1 together with BACKEND_ORIGIN below: iOS browsers drop the session
# cookie when the API is on a different domain, so sign-in fails on iPhones.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Server-only: ladder-backend origin that /api/v1/* is proxied to (no /api/v1, no trailing slash)
BACKEND_ORIGIN=
# true = start MSW in development. Nothing is mocked today (ladder-backend serves every endpoint);
# keep it for future endpoints the backend does not have yet (rules.md §11)
NEXT_PUBLIC_USE_MOCKS=true
